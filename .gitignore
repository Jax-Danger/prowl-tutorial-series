# Prowl project root.
# Tracked: Assets/ (scripts, scenes, prefabs, .meta), Boot/,
# Directory.Build.props, Directory.Build.targets, *.prowl, *.slnx.
# ProjectSettings/ is created when the editor opens the project.
# Assets/ plus the .prowl marker is enough to open. *.csproj stays
# ignored because HintPaths point at the local engine install.

Library/
Temp/
Logs/
Packages/
ProjectSettings/
Assets/temp/
*.csproj
*.sln
.vs/
bin/
obj/
Builds/
.DS_Store
